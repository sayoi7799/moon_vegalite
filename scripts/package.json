{
  "name": "moon-vegalite-fixtures",
  "private": true,
  "version": "0.1.0",
  "description": "Generates test fixtures for moon_vegalite from the official vega-lite / vega implementations",
  "type": "module",
  "scripts": {
    "examples": "node fetch_examples.mjs",
    "fixtures": "node fetch_examples.mjs && node gen_fixtures.mjs",
    "gallery": "node fetch_examples.mjs && node gen_gallery.mjs",
    "site-examples": "node fetch_examples.mjs && node gen_site_examples.mjs",
    "site": "node build_site.mjs",
    "serve": "node serve_site.mjs",
    "bench": "node bench/vega_bench.mjs --check"
  },
  "dependencies": {
    "roughjs": "4.6.6",
    "vega": "5.33.1",
    "vega-datasets": "3.2.1",
    "vega-lite": "5.23.0"
  }
}
