// Official examples: the scenegraph and SVG produced here must equal what
// vega-lite 5.23.0 + vega 5.33.1 produce (fixtures/vlexamples, generated by
// scripts/gen_fixtures.mjs).

///|
fn close_num(a : Double, b : Double) -> Bool {
  (a - b).abs() <= 1.0e-9 * @util.js_max(1.0, @util.js_max(a.abs(), b.abs()))
}

///|
/// Compare two JSON values (numbers with a relative tolerance), collecting the
/// paths that differ.
fn json_diff(
  ours : Json,
  official : Json,
  path : String,
  out : Array[String],
) -> Unit {
  match (ours, official) {
    (Number(a, ..), Number(b, ..)) =>
      if !close_num(a, b) {
        out.push(path + ": " + a.to_string() + " != " + b.to_string())
      }
    (Array(a), Array(b)) => {
      if a.length() != b.length() {
        out.push(
          path +
          ": length " +
          a.length().to_string() +
          " != " +
          b.length().to_string(),
        )
      }
      let n = @util.js_min(a.length().to_double(), b.length().to_double()).to_int()
      for i in 0..<n {
        json_diff(a[i], b[i], path + "[" + i.to_string() + "]", out)
      }
    }
    (Object(a), Object(b)) => {
      for k, v in a {
        match b.get(k) {
          Some(w) => json_diff(v, w, path + "." + k, out)
          None =>
            // `interactive: true` and `clip: false` are the omitted defaults
            match (k, v) {
              ("interactive", True) | ("clip", False) => ()
              _ => out.push(path + "." + k + ": not in the official scene")
            }
        }
      }
      for k, _ in b {
        // gradient ids are assigned while rendering
        if !a.contains(k) && !(k == "id" && path.has_suffix(".fill")) {
          out.push(path + "." + k + ": missing")
        }
      }
    }
    (a, b) =>
      if a != b {
        out.push(path + ": " + a.stringify() + " != " + b.stringify())
      }
  }
}

///|
test "official examples: scenegraph and SVG" {
  let failures : Array[String] = []
  for c in @vlexamples.cases() {
    let (name, spec, scene, svg) = c
    let compiled = @vl.compile(spec)
    let expected_full : Json = @json.parse(scene)
    let (expected, view) = match expected_full {
      Object(m) => {
        let rest : Map[String, Json] = Map([])
        for k, v in m {
          if k != "view" {
            rest[k] = v
          }
        }
        (Json::object(rest), m.get("view"))
      }
      other => (other, None)
    }
    let ours = @scene.mark_to_json(compiled.scene, with_bounds=true)
    let diffs : Array[String] = []
    json_diff(ours, expected, "scene", diffs)
    let our_view : Json = {
      "width": compiled.width,
      "height": compiled.height,
      "origin": [compiled.origin.0, compiled.origin.1],
      "background": match compiled.background {
        Some(b) => b
        None => Json::null()
      },
    }
    match view {
      Some(v) => json_diff(our_view, v, "view", diffs)
      None => ()
    }
    if diffs.length() > 0 {
      failures.push(
        name +
        ": " +
        diffs[0] +
        " (" +
        diffs.length().to_string() +
        " differences)",
      )
    }
    let got = @svg.render_svg(
      compiled.scene,
      @svg.SvgOptions::new(
        compiled.view_width + 2.0 * compiled.padding,
        compiled.view_height + 2.0 * compiled.padding,
        origin=(
          compiled.origin.0 + compiled.padding,
          compiled.origin.1 + compiled.padding,
        ),
        background?=compiled.background,
      ),
    )
    if got != @util.unescape_fixture(svg) {
      failures.push(name + ": SVG differs")
    }
  }
  if failures.length() > 0 {
    fail(failures.join("\n"))
  }
}
